# ============================================================
# LLM 供应商配置（仅「AI 综合研判」功能需要）
#
# 不配置也不影响使用：行情、K 线、技术指标、资讯、告警全部照常工作，
# 只有 AI 研判面板会提示未配置。
#
# 三选一即可。未显式设置 LLM_PROVIDER 时，按 DeepSeek → Anthropic → OpenAI
# 的顺序自动选用已配置 key 的那一个。
# ============================================================


# ---------- 方案一：DeepSeek（推荐国内使用）----------
# 优点：api.deepseek.com 在中国大陆直连可达，无需任何代理；价格远低于其它选项。
# 注意：DeepSeek 只支持 json_object 模式而非 schema 强校验，
#      本项目已内置格式说明注入、JSON 提取修复与带错误反馈的自动重试。
# 获取：https://platform.deepseek.com/api_keys

# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_MODEL=deepseek-v4-pro
#   deepseek-v4-pro   推理更充分，适合研判这类需权衡多维证据的任务，推荐
#   deepseek-v4-flash 更快更便宜，质量略低
#   两者均支持 json_object，且推理过程走独立的 reasoning_content 字段，
#   不会污染 JSON 输出。实测于 2026-08，模型列表可能变动，
#   可用 curl -H "Authorization: Bearer $KEY" https://api.deepseek.com/models 查询
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1


# ---------- 方案二：中转站 ----------
# 国内中转站多为 OpenAI 格式，常可用 claude-* / gpt-* 等模型名转发到对应上游。
# 用哪一种取决于你的中转站提供的是哪种接口格式。

# --- 2a. OpenAI 格式中转站（最常见，实测最快）---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://你的中转站域名/v1
# OPENAI_MODEL=claude-opus-5
#   模型名填中转站支持的任意名称。可用以下命令查询该站支持哪些模型：
#     curl -H "Authorization: Bearer $KEY" https://你的中转站域名/v1/models
#
#   ⚠️ 多数中转站需要【直连】，走代理反而会超时。若你同时配置了 HTTPS_PROXY
#      （OKX 衍生品数据需要），必须用 NO_PROXY 把中转站域名排除在外：
#
#        HTTPS_PROXY=http://127.0.0.1:7890 \
#        NO_PROXY=localhost,127.0.0.1,你的中转站域名 \
#        npm run dev
#
#      实测：某中转站直连 HTTP 200 / 经美国节点代理 CONNECT_TIMEOUT，
#      而 OKX 恰好相反。两者必须走不同路径，NO_PROXY 是最省事的解法。

# --- 2b. Anthropic 格式中转站 ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-xxxxxxxx
# ANTHROPIC_BASE_URL=https://你的中转站域名
# ANTHROPIC_MODEL=claude-opus-5
#   若该中转站不支持 structured outputs（返回 400/404），
#   本项目会自动降级为提示词约束 + 本地校验，无需你做任何处理


# ---------- 方案三：Anthropic 官方 ----------
# 注意：api.anthropic.com 在中国大陆直连返回 403，必须配合代理使用（见下方 HTTPS_PROXY）。
# 获取：https://console.anthropic.com/settings/keys

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=claude-opus-5


# ============================================================
# 研判缓存策略（可选）
#
# 每次研判都是一次真实付费调用（实测 23-95 秒不等），而几分钟内的行情变化
# 通常不足以改变结论。默认在「距上次研判 30 分钟内」且「价格漂移小于
# 0.5 × 上次研判时的 ATR%」时复用上次结果，不再调用模型。
#
# 漂移阈值按标的自身波动率换算，并夹在 0.3%~3% 之间——
# 固定百分比会让低波动币几乎永远命中缓存、高波动币几乎永远不命中。
#
# 界面命中缓存时会明确提示，并提供「强制重算」入口，随时可拿到最新结论。
# ============================================================

# 复用时限（分钟），设为 0 可完全禁用缓存
# ANALYSIS_CACHE_TTL_MINUTES=30

# 漂移阈值系数：允许漂移 = 该系数 × 上次研判时的 ATR%
# 调小则更容易触发重新研判（更贵更新鲜），调大则更省
# ANALYSIS_CACHE_DRIFT_FACTOR=0.5

# 资讯 AI 汇总的复用时限（分钟）。
# 技术面右下角的资讯汇总同样是一次真实的模型调用，且面板一挂载就会请求它。
# 资讯面的主线在几十分钟内通常不会变，所以默认复用 20 分钟；
# 面板上的「重新汇总」可随时跳过缓存重算。
# NEWS_DIGEST_TTL_MINUTES=20


# ============================================================
# 宏观数据源（可选，但强烈建议配）
#
# 两个都是免费 key，且实测从中国大陆直连可达，无需代理。
# 不配也不影响使用：利率与议息倒计时走无需 key 的公开接口，
# 只是拿不到净流动性、宏观数值序列、数据发布日历与扩展资讯。
# 分工与降级行为详见 docs/DATA-FRAMEWORK.md。
# ============================================================

# FRED —— 美联储圣路易斯分行的宏观数据库。
# 提供净流动性（美联储总资产 − 逆回购 − 财政部账户）、利率、通胀、
# 数据发布日历，以及 ALFRED 的历史修订（用于防止回测作弊）。
# 免费申请：https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=xxxxxxxx

# Finlight —— 金融资讯 API，一次请求覆盖数百家源，自带分类标签。
# 注意：免费档不返回实体识别与正文（请求带 includeEntities 不报错但无字段）。
# 所以鹰鸽判断不依赖它，而是从美联储官方原文自己算。
# 申请：https://docs.finlight.me
# FINLIGHT_API_KEY=sk_xxxxxxxx


# ============================================================
# 告警与通知（可选）
#
# 告警在服务端求值：只要 npm run dev / start 在跑，
# 无论浏览器是否打开都会持续监控。规则存在 data/alert-rules.json。
#
# 注意：告警只在服务运行时求值。常驻部署（开机自启、崩溃拉起）见 docs/DEPLOY.md。
# 代理变量必须写在进程环境里，写进本文件对 NODE_USE_ENV_PROXY 无效。
# ============================================================

# data/ 快照的存放位置。默认 data/backups——但那与源文件在同一块盘上，
# 只防误删和写坏，防不住硬盘故障。指到外接盘或同步盘才算真备份。
# DATA_BACKUP_DIR=/Volumes/外接盘/crypto-radar-backups

# 轮询间隔（秒），最小 20。默认 60。
# 技术指标基于 K 线，更频繁除了浪费配额没有实际意义
# ALERTS_POLL_SECONDS=60

# 设为 false 可完全关闭告警轮询
# ALERTS_ENABLED=true

# --- 通知通道（推荐：群机器人 webhook）---
#
# 企业微信 / 钉钉 / 飞书 三家都支持，填一条 webhook URL 即可，
# 厂商由域名自动识别，无需额外指定。实测国内直连延迟最低（270-320ms）。
#
# 获取 webhook URL：
#   企业微信：群聊右上角 → 群机器人 → 添加 → 复制 Webhook 地址
#   钉  钉：群设置 → 机器人 → 添加 → 自定义 → 复制 Webhook 地址
#   飞  书：群设置 → 群机器人 → 添加 → 自定义机器人 → 复制 Webhook 地址
#
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# 钉钉与飞书添加机器人时会要求选一种安全设置，按你选的那种填写下面之一：
#
#   选「加签」→ 填 ALERT_WEBHOOK_SECRET（钉钉的以 SEC 开头）
#   选「自定义关键词」→ 填 ALERT_WEBHOOK_KEYWORD，该词会自动加在消息开头
#   选「IP 地址段」→ 两个都不用填
#
# 企业微信没有加签机制，两个都不用填。
#
# ALERT_WEBHOOK_SECRET=SECxxxxxxxxxxxxxxxxxxxxxxxx
# ALERT_WEBHOOK_KEYWORD=告警

# --- Telegram（可选，与上面的群机器人可同时启用）---
# 若两者都配置，告警会同时推送到两边。
#
# 获取步骤：
#   1. Telegram 中搜索 @BotFather，发送 /newbot，按提示创建，得到 Bot Token
#   2. 搜索你刚创建的 bot，点 Start 发一条消息给它
#   3. 浏览器打开 https://api.telegram.org/bot<你的Token>/getUpdates
#      在返回的 JSON 里找到 result[0].message.chat.id，那就是 Chat ID
#
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789

# 配置完成后重启服务，在告警面板点「发送测试」验证。


# ============================================================
# 网络代理（可选）
#
# Node.js 的 fetch 默认不读代理环境变量，服务端会绕过 VPN 直连。
# npm run dev / start 已内置 NODE_USE_ENV_PROXY=1，你只需提供代理地址。
#
# 提示：若使用 DeepSeek，行情与研判全链路都不需要代理，
#      只有 OKX 衍生品数据需要。详见 docs/DATA-SOURCES.md。
#
# 该变量建议在启动命令中给出，而不是写在这里：
#   HTTPS_PROXY=http://127.0.0.1:7890 npm run dev
# ============================================================
